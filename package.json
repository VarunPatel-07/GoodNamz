{
  "name": "goodnamz",
  "displayName": "GoodNamz",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "goodnamz",
      "properties": {
        "goodnamz.ignoreGlobalNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Globally ignored names"
        },
        "goodnamz.workspaceIgnoreNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Globally ignored names"
        }
      }
    },
    "commands": [
      {
        "command": "goodnamz.ignoreGlobal",
        "title": "Ignore name in Globally"
      },
      {
        "command": "goodnamz.ignoreWorkspace",
        "title": "Ignore name in workspace"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}